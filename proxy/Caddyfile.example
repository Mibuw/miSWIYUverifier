# Reverse proxy for the swiyu-verifier — TEMPLATE.
# Copy to proxy/Caddyfile and replace the <PLACEHOLDERS>
# (proxy/Caddyfile is excluded from the repo via .gitignore).
#
# Terminates TLS and forwards ONLY the OID4VP interface — the
# management API (/management/*) stays unreachable from outside.
#
# Run:  caddy run --config proxy\Caddyfile

{
	# No listener on port 80 (in case another service already runs there;
	# port 80 is not forwarded by the router anyway)
	auto_https disable_redirects
}

<YOUR-DOMAIN> {
	# Publicly trusted certificate (e.g. Let's Encrypt) as PEM;
	# the swiyu app rejects self-signed certificates.
	tls "<PATH>/public.crt" "<PATH>/private.key"

	handle /oid4vp/* {
		reverse_proxy localhost:8083
	}

	# Everything else (incl. /management/*) → 404
	handle {
		respond 404
	}
}
