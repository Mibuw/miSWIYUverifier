# Template: copy to docker/.env and fill in the values.
# docker/.env is excluded from the repo via .gitignore (it contains the private key!).

# Public HTTPS URL under which the verifier service is reachable from the
# smartphone (reverse proxy or tunnel). NO trailing slash.
# Example: https://verifier.example.com
EXTERNAL_URL=https://REPLACE-ME.example.com

# DID of the verifier from the swiyu identifier registry (see README, onboarding)
VERIFIER_DID=did:webvh:REPLACE-ME:identifier-reg.trust-infra.swiyu-int.admin.ch:api:v1:did:REPLACE-ME

# DID + key fragment of the public key (from the DID log of the DID toolbox)
DID_VERIFICATION_METHOD=did:webvh:REPLACE-ME:identifier-reg.trust-infra.swiyu-int.admin.ch:api:v1:did:REPLACE-ME#auth-key-01

# EC P-256 private key (PEM) that signs the request objects.
# Created by the DID toolbox (.didtoolbox/auth-key-01) or via:
#   openssl ecparam -genkey -name prime256v1 -noout -out ec_private.pem
# Multi-line value in double quotes (supported by Docker Compose v2).
SIGNING_KEY="-----BEGIN EC PRIVATE KEY-----
REPLACE-ME
-----END EC PRIVATE KEY-----"

# Validity of a verification offer in seconds (default 900)
VERIFICATION_TTL_SEC=900
