# Vorlage: nach docker/.env kopieren und Werte eintragen.
# docker/.env ist per .gitignore vom Repo ausgeschlossen (enthält den Private Key!).

# Öffentliche HTTPS-URL, unter der der verifier-service vom Smartphone aus
# erreichbar ist (Tunnel oder eigene Domain). KEIN abschließender Slash.
# Beispiel Cloudflare Tunnel: https://xyz.trycloudflare.com
EXTERNAL_URL=https://REPLACE-ME.example.com

# DID des Verifiers aus der swiyu Identifier-Registry (siehe README, Onboarding)
VERIFIER_DID=did:tdw:REPLACE-ME:identifier-reg.trust-infra.swiyu-int.admin.ch:api:v1:did:REPLACE-ME

# DID + Key-Fragment des Public Keys (aus dem DID-Log der DID-Toolbox)
DID_VERIFICATION_METHOD=did:tdw:REPLACE-ME:identifier-reg.trust-infra.swiyu-int.admin.ch:api:v1:did:REPLACE-ME#auth-key-01

# EC P-256 Private Key (PEM), der die Request Objects signiert.
# Erzeugt von der DID-Toolbox (.didtoolbox/auth-key-01) oder via:
#   openssl ecparam -genkey -name prime256v1 -noout -out ec_private.pem
# Mehrzeiliger Wert in doppelten Anführungszeichen (Docker Compose v2 unterstützt das).
SIGNING_KEY="-----BEGIN EC PRIVATE KEY-----
REPLACE-ME
-----END EC PRIVATE KEY-----"

# Gültigkeit eines Verification-Angebots in Sekunden (Default 900)
VERIFICATION_TTL_SEC=900
