<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>miSWIYUverifier</AssemblyName>
    <RootNamespace>miSWIYUverifier</RootNamespace>
    <!-- This host is never packed; the NuGet package is the Core library, which
         claims the id "miSWIYUverifier". Without a distinct PackageId here NuGet
         sees two projects under that name and restore fails with
         "Ambiguous project name 'miSWIYUverifier'". -->
    <IsPackable>false</IsPackable>
    <PackageId>miSWIYUverifier.WebApp</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <!-- All services, models and config come from the core library -->
    <ProjectReference Include="..\miSWIYUverifier.Core\miSWIYUverifier.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
