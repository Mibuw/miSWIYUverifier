    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>miSWIYUverifier</AssemblyName>
    <RootNamespace>miSWIYUverifier</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Alle Services, Models und Config kommen aus der Core-Library -->
